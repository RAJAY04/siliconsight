#!/bin/bash
# Starts an installed SiliconSight on the first free port from 7878 and opens it in the browser.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"

port=7878
while curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$port/"; do
  port=$((port + 1))
  ((port < 7900)) || { echo "ports 7878 to 7899 are all in use" >&2; exit 1; }
done

# Waits for the port, then opens the page. $$ becomes macviz below, so this stops if macviz exits.
(
  for _ in $(seq 1 100); do
    kill -0 $$ 2>/dev/null || exit 0
    if curl -sf -o /dev/null "http://127.0.0.1:$port/"; then open "http://127.0.0.1:$port/"; exit 0; fi
    sleep 0.2
  done
) &

echo "SiliconSight is running at http://127.0.0.1:$port/"
echo "Press Ctrl-C to stop. Start it again any time with: ~/.siliconsight/siliconsight"
exec "$here/macviz" --port "$port" --web "$here/web"
